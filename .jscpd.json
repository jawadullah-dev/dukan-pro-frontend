{
  "path": ["src"],
  "pattern": "**/*.{ts,tsx}",
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/src/components/ui/**",
    "**/src/styles/**",
    "**/src/constants/mock*/**",
    "**/src/lib/dukaan/operations.ts"
  ],
  "minLines": 7,
  "minTokens": 60,
  "threshold": 0,
  "format": ["typescript"],
  "reporters": ["console"],
  "skipLocal": false,
  "absolute": false,
  "silent": false,
  "exitCode": 1
}
