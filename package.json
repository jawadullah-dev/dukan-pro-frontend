{
  "name": "dukaan-pro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3006",
    "build": "next build",
    "start": "next start -p 3006",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/components/data-table/resolve-mobile-item.test.ts",
    "check": "node scripts/run-checks.mjs",
    "knip": "knip --reporter compact",
    "duplicates": "jscpd --config .jscpd.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && npm run format",
    "lint:strict": "oxlint --deny-warnings",
    "format": "oxfmt --write . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "format:check": "oxfmt --check . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "generate:icons": "node scripts/generate-icons.mjs",
    "cleanup": "node scripts/cleanup.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@sentry/nextjs": "^10.76.0",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "kbar": "^1.0.0",
    "match-sorter": "^8.3.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nuqs": "^2.10.1",
    "postcss": "8.5.29",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-dropzone": "^20.1.2",
    "recharts": "3.10.1",
    "serwist": "^9.5.13",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "7.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@faker-js/faker": "^10.6.0",
    "@serwist/turbopack": "^9.5.13",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "knip": "^6.40.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.29",
    "sharp": "^0.35.5"
  },
  "lint-staged": {
    "!(scripts)/**/*.{js,jsx,tsx,ts,css,less,scss,sass}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
