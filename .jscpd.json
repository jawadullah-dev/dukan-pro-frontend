{
  "path": ["src"],
  "pattern": "**/*.{ts,tsx}",
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/src/components/ui/**",
    "**/src/styles/**",
    "**/src/constants/mock*/**",
    "**/src/lib/dukaan/operations.ts"
  ],
  "minLines": 8,
  "minTokens": 75,
  "threshold": 3,
  "format": ["typescript", "tsx"],
  "reporters": ["console"],
  "skipLocal": false,
  "absolute": false,
  "silent": false
}

